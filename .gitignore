# secrets — never commit keys
.env
*.env
.env.local
.env*.local
**/.env.local
!.env.example
!**/.env.example

# python
__pycache__/
*.pyc
.venv/
venv/

# node / next
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# generated media + local memory/reports
backend/media/
# Ignore the *contents* of backend/data (local DBs, keys, reports) but keep the
# n8n workflow catalog, which the backend needs at runtime in production.
# (Git can't re-include a file if its parent directory itself is excluded.)
backend/data/*
!backend/data/workflow_catalog.json

# private business/architecture map — NEVER push to the public repo
knowledge_base/

# misc
.DS_Store
*.log
